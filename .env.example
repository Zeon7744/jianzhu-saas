# jianzhu-saas 环境变量模板
# 复制为 .env 并填入真实值
# 注意：.env 文件不要提交到 Git！

# ============ 网关选择 ============
# 可选值：noop | aishouqian | xunhupay | wepay
# noop       = 占位网关，不真实扣款（MVP 演示用）
# aishouqian = 爱收钱聚合支付（个人/小微，需商户后台审批）
# xunhupay   = 虎皮椒（个人 10 分钟开通，H5/QR 收款，推荐首选）
# wepay      = 微信商户（需企业主体）
JZ_SAAS_BILLING_GATEWAY=noop

# ============ 虎皮椒（Xunhupay，个人主体推荐）============
# 注册：https://www.xunhupay.com/ → 选"个人商户" → 实名（身份证）→ 拿 appid + appsecret
# APPID（虎皮椒后台 → 应用管理 → APPID）
JZ_SAAS_XUNHU_APPID=
# APPSECRET（虎皮椒后台 → 应用管理 → APPSECRET）
JZ_SAAS_XUNHU_APPSECRET=
# 网关地址（默认官方，备用平台可换）
JZ_SAAS_XUNHU_GATEWAY=https://api.xunhupay.com/payment/do.html
# 异步回调地址（公网 HTTPS URL，虎皮椒支付成功后 POST 到此地址）
JZ_SAAS_XUNHU_NOTIFY=
# 同步跳转地址（支付后浏览器跳回，可选）
JZ_SAAS_XUNHU_RETURN=
# 插件标识（可选，默认 jianzhu-saas）
JZ_SAAS_XUNHU_PLUGINS=jianzhu-saas

# ============ 爱收钱（Aishouqian）============
# 商户编号（爱收钱后台 → 账户信息 → 商户编号）
JZ_AISHOUQIAN_MCH_NO=
# API Token（爱收钱后台 → API 管理 → 生成 Token）
JZ_AISHOUQIAN_TOKEN=
# 应用 ID（爱收钱后台 → 应用管理 → 应用 ID）
JZ_AISHOUQIAN_APPID=

# ============ 微信商户（WxPay，企业主体用）============
# 商户号（微信商户平台 → 账户中心 → 商户信息）
JZ_WXPAY_MCHID=
# 应用 ID（微信开放平台 → 应用管理）
JZ_WXPAY_APPID=
# API 密钥（微信商户平台 → 账户中心 → API 安全 → API 密钥）
JZ_WXPAY_API_KEY=
# 证书序列号（微信商户平台 → 账户中心 → API 安全 → API 证书）
JZ_WXPAY_SERIAL_NO=
# 商户私钥（API 证书中的 apiclient_key.pem 内容）
JZ_WXPAY_PRIVATE_KEY=
# 支付回调地址（你的服务器 URL + /billing/callback）
JZ_WXPAY_NOTIFY_URL=

# ============ JWT 密钥 ============
# 生产环境请生成强随机字符串：python -c "import secrets; print(secrets.token_hex(32))"
# 开发环境可用默认值
JZ_JWT_SECRET=change-me-in-production

# ============ 数据库（预留）============
# 当前使用 SQLite（data/jianzhu_saas.db）
# 后续可切换到 PostgreSQL
# DATABASE_URL=postgresql://user:pass@localhost:5432/jianzhu_saas

# ============ 演示租户（生产环境建议关闭）============
# 是否允许 demo 租户免密登录（true/false）
ALLOW_DEMO_TENANT=true
