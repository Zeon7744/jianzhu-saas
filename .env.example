# jianzhu-saas 环境变量模板（只含 key 名，不含真实值）
# 网关选择：noop / aishouqian / xunhupay（虎皮椒，个人推荐）
JZ_SAAS_BILLING_GATEWAY=noop

# 虎皮椒 XunHupay（个人开通门槛最低，只需 pid）
JZ_SAAS_XUNHU_PID=
JZ_SAAS_XUNHU_MERCHANT=jianzhu-saas
JZ_SAAS_XUNHU_NAME=
JZ_SAAS_XUNHU_RETURN=/billing/return
JZ_SAAS_XUNHU_NOTIFY=/billing/callback

# 爱收钱聚合（企业/小微，费率 0.55%）
JZ_SAAS_AISQ_MERCHANT_NO=
JZ_SAAS_AISQ_APP_KEY=
JZ_SAAS_AISQ_APP_SECRET=
JZ_SAAS_AISQ_NOTIFY_URL=/billing/callback
