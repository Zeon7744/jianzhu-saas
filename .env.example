# jianzhu-saas 环境变量模板
# 复制为 .env 并填入真实值；.env 不要提交到 Git！
#
# 一键启动默认无需任何配置（SQLite 文件库 + noop 网关 + 演示账号），
# 只有接真实支付/生产部署时才需要下面这些变量。

# ============ 网关选择 ============
# 可选值：noop | aishouqian | wepay | afdian
#   noop       = 占位网关，不真实扣款（MVP 演示用，默认）
#   aishouqian = 爱收钱聚合支付（个人/小微可用，MVP 门槛最低）
#   wepay      = 微信商户支付（需企业主体）
#   afdian     = 爱发电赞助（个人开发者按月赞助，适合开源变现）
JZ_SAAS_BILLING_GATEWAY=noop

# ============ 爱收钱（Aishouqian）============
JZ_AISHOUQIAN_MCH_NO=
JZ_AISHOUQIAN_TOKEN=
JZ_AISHOUQIAN_APPID=

# ============ 微信商户（WxPay，企业主体用）============
JZ_WXPAY_MCHID=
JZ_WXPAY_APPID=
JZ_WXPAY_API_KEY=
JZ_WXPAY_SERIAL_NO=
JZ_WXPAY_PRIVATE_KEY=
JZ_WXPAY_NOTIFY_URL=

# ============ 爱发电（Afdian，个人开发者赞助）============
JZ_AFDIAN_TOKEN=
JZ_AFDIAN_USER=
JZ_AFDIAN_NOTIFY_URL=

# ============ 服务/安全 ============
# 服务端口（python -m jianzhu_saas.cli 默认 8890）
JZ_SAAS_PORT=8890
# SQLite 数据库路径（默认 data/jianzhu_saas.db；演示可传 :memory:）
JZ_SAAS_DB=data/jianzhu_saas.db
# JWT 签名密钥。生产请生成强随机串：python -c "import secrets; print(secrets.token_hex(32))"
JZ_SAAS_SECRET=change-me-in-production

# ============ 演示租户 ============
# 是否允许 demo / demo_pro 演示账号（true/false）。生产环境建议 false。
ALLOW_DEMO_TENANT=true
