# jianzhu-saas 环境变量模板
# 复制为 .env 并填入真实值
# 注意：.env 文件不要提交到 Git！

# ============ 网关选择 ============
# 可选值：noop | aishouqian | afdian | wepay
# noop       = 占位网关，不真实扣款（MVP 演示用）
# aishouqian = 爱收钱聚合支付（个人/小微，需商户后台审批）
# afdian     = 爱发电（token 鉴权，个人/团队均可开通，无域名强制要求，推荐首选）
# wepay      = 微信商户（需企业主体）
JZ_SAAS_BILLING_GATEWAY=noop

# ============ 爱发电（Afdian，个人创作者推荐）============
# 开通：注册 https://afdian.net/ → 个人实名 → 开发者后台 https://afdian.net/dashboard/dev 拿 user_id + API Token
# USER_ID（爱发电开发者页，标识你是谁，必填）
JZ_SAAS_AFDIAN_USER=
# API TOKEN（爱发电开发者页底部生成，参与接口签名，敏感值填本地 .env，勿提交 Git）
JZ_SAAS_AFDIAN_TOKEN=
# API 基址（默认官方）
JZ_SAAS_AFDIAN_BASE=https://afdian.net/api
# 支付成功跳转地址（完整 https URL；走爱发电 Webhook 时建议用 GitHub Pages success 页）
JZ_SAAS_AFDIAN_RETURN=
# Webhook 接收地址（可选；留空则只走 API 主动查询 query-order，零服务器、零备案方案）
JZ_SAAS_AFDIAN_WEBHOOK=
# Webhook 验签公钥（可选，2025-07 起爱发电推送带 RSA-SHA256 sign；不配则退化为结构校验）
JZ_SAAS_AFDIAN_WEBHOOK_PUBKEY=

# ============ 爱收钱（Aishouqian）============
# 商户编号（爱收钱后台 → 账户信息 → 商户编号）
JZ_AISHOUQIAN_MCH_NO=
# API Token（爱收钱后台 → API 管理 → 生成 Token）
JZ_AISHOUQIAN_TOKEN=
# 应用 ID（爱收钱后台 → 应用管理 → 应用 ID）
JZ_AISHOUQIAN_APPID=

# ============ 微信商户（WxPay，企业主体用）============
# 商户号（微信商户平台 → 账户中心 → 商户信息）
JZ_WXPAY_MCHID=
# 应用 ID（微信开放平台 → 应用管理）
JZ_WXPAY_APPID=
# API 密钥（微信商户平台 → 账户中心 → API 安全 → API 密钥）
JZ_WXPAY_API_KEY=
# 证书序列号（微信商户平台 → 账户中心 → API 安全 → API 证书）
JZ_WXPAY_SERIAL_NO=
# 商户私钥（API 证书中的 apiclient_key.pem 内容）
JZ_WXPAY_PRIVATE_KEY=
# 支付回调地址（你的服务器 URL + /billing/callback）
JZ_WXPAY_NOTIFY_URL=

# ============ JWT 密钥 ============
# 生产环境请生成强随机字符串：python -c "import secrets; print(secrets.token_hex(32))"
# 开发环境可用默认值
JZ_JWT_SECRET=change-me-in-production

# ============ 数据库（预留）============
# 当前使用 SQLite（data/jianzhu_saas.db）
# 后续可切换到 PostgreSQL
# DATABASE_URL=postgresql://user:pass@localhost:5432/jianzhu-saas

# ============ 演示租户（生产环境建议关闭）============
# 是否允许 demo 租户免密登录（true/false）
ALLOW_DEMO_TENANT=true
